[Unit]
Description=IP and DNS destination route manager
Wants=network-online.target
After=network-online.target NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/local/bin/routekeeper daemon --interval 60
Restart=on-failure
RestartSec=10
StateDirectory=routekeeper
ConfigurationDirectory=routekeeper
UMask=0022
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/etc/routekeeper /var/lib/routekeeper
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
